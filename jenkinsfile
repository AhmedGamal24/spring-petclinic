pipeline{
    agent any
    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }
    stages{
        stage("checkout"){
            steps{
                git branch : "main" , url: "https://github.com/AhmedGamal24/spring-petclinic.git"
                }
            }
        stage("test & build"){
            steps{
                sh 'mvn clean test'
            }
        }
    }

    
}
